# Required in production
APP_EMAIL=her@email.com
APP_PASSCODE=choose-a-passcode
SESSION_SECRET=any-long-random-string
GEMINI_API_KEY=your-google-ai-studio-key

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
DATA_DIR=/data
# Appended to every description. Use \n for line breaks.
LISTING_FOOTER=Happy to bundle. Posted within 1 working day.
# Shared secret between OnePost and the Chrome extension
WORKER_TOKEN=any-long-random-string
